# -----------------------------
# Local LLM (Ollama) settings
# -----------------------------

# Used by llm1.py (LocalLLMClient)
LOCAL_LLM_BASE_URL=http://localhost:11434

# Used by matcher1.py (_llm_chat)
# If you expose Ollama in OpenAI-compatible mode on another service, set full endpoint here.
# Example: http://localhost:8000/v1/chat/completions
GEMMA_ENDPOINT=http://localhost:11434/api/chat

# Optional bearer token for GEMMA_ENDPOINT (leave blank for local Ollama)
GEMMA_API_KEY=

# Model name you are using locally
LLM_MODEL=mistral:7b-instruct   #gemma4:e4b
